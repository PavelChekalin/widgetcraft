<?xml version="1.0" encoding="utf-8"?>
<!--
  Важно: targetCellWidth / targetCellHeight НЕ задаём.
  Лаунчер Realme при их наличии раздувает высоту виджета до 3 клеток.
  Размер задаётся только minWidth/minHeight + minResizeWidth/minResizeHeight.
  5 колонок × 2 ряда при 70dp на клетку: 5*70-30=320dp, 2*70-30=110dp.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_desc"
    android:initialLayout="@layout/widget_craft"
    android:minHeight="110dp"
    android:minResizeHeight="70dp"
    android:minResizeWidth="110dp"
    android:minWidth="320dp"
    android:previewLayout="@layout/widget_craft"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
